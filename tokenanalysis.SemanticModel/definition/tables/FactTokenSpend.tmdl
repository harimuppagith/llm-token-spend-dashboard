table FactTokenSpend
	lineageTag: e9af89f0-a532-4f84-90a3-31e9aa5a1e2a

	measure 'Total  Spend.' = SUM(FactTokenSpend[SpendUSD])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Spend
		lineageTag: bd388682-e79a-48d0-8757-a324b5cae8ee

	measure 'Total Tokens (Thousands)' = SUMX(FactTokenSpend, FactTokenSpend[TokensMillions] * 1000)
		formatString: #,0
		displayFolder: Spend
		lineageTag: 9f603d00-1a07-47e8-a2fd-993c7b051903

	measure 'Cost per 1K Tokens' = DIVIDE([Total  Spend.], [Total Tokens (Thousands)])
		formatString: "$"0.00
		displayFolder: Spend
		lineageTag: d48b88df-d084-4559-9005-79300dfda2ae

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Total Spend - Prior Week' = CALCULATE([Total  Spend.], FILTER(ALL(DimDate), DimDate[WeekIndex] = MAX(DimDate[WeekIndex]) - 1))
		formatString: 0
		displayFolder: Spend
		lineageTag: bb5fef2e-9f34-46c8-9969-5eff34451516

	measure 'Spend WoW %' = DIVIDE([Total  Spend.] - [Total Spend - Prior Week], [Total Spend - Prior Week])
		formatString: "↑ "0.0%;"↓ "0.0%
		displayFolder: Spend
		lineageTag: c20b4d10-c2cd-4bc9-b78e-f9809f95e764

	measure 'Spend - Division Attributed' = CALCULATE([Total  Spend.], FactTokenSpend[Division] <> "Unattributed")
		formatString: "$"#,0
		displayFolder: Coverage
		lineageTag: cd62bebc-8ef3-4b81-a202-350a22ef9d1e

	measure 'Division Coverage %' = DIVIDE([Spend - Division Attributed], [Total  Spend.])
		formatString: 0.0%
		displayFolder: Coverage
		lineageTag: 4498ad8e-bb29-41df-998e-9e28325b9ee2

	measure 'Spend - Application Attributed' = CALCULATE([Total  Spend.], FactTokenSpend[Application] <> "Unattributed")
		formatString: "$"#,0
		displayFolder: Coverage
		lineageTag: 4fa88496-b61d-4cde-a7ce-06d3e525744b

	measure 'Application Coverage %' = DIVIDE([Spend - Application Attributed], [Total  Spend.])
		formatString: 0.0%
		displayFolder: Coverage
		lineageTag: 8db423de-e1f2-447f-abf9-ecca9e993bbe

	measure 'Spend - User Attributed' = CALCULATE([Total  Spend.], FactTokenSpend[User] <> "Unattributed")
		formatString: "$"#,0
		displayFolder: Coverage
		lineageTag: 2dbf01b6-1c3f-49c1-bee9-d4162361c0c8

	measure 'User Coverage %' = DIVIDE([Spend - User Attributed], [Total  Spend.])
		formatString: 0.0%
		displayFolder: Coverage
		lineageTag: 5d8e48cb-499c-4004-8ae1-4e9c5ada0fa9

	measure 'Ambiguous Cost' = [Total  Spend.] - [Spend - Application Attributed]
		formatString: "$"#,0
		displayFolder: Coverage
		lineageTag: b83e705f-775d-4bc6-b68f-7221867afeea

	measure 'Ambiguous Cost %' = 1 - [Application Coverage %]
		formatString: 0.0%
		displayFolder: Coverage
		lineageTag: 28560ecd-0de2-42e8-bd7c-90c0d68c058c

	measure 'Ambiguous Cost % - 3wk Avg' = VAR CurrentWeek = MAX(DimDate[WeekIndex]) VAR Last3Weeks = FILTER(ALL(DimDate), DimDate[WeekIndex] <= CurrentWeek && DimDate[WeekIndex] > CurrentWeek - 3) RETURN CALCULATE([Ambiguous Cost %], Last3Weeks)
		formatString: 0.0%
		displayFolder: Coverage
		lineageTag: f80dd0bb-ec52-4fec-981f-1fffa114101b

	measure 'Measured Spend' = CALCULATE([Total  Spend.], DimAttributionQuality[AttributionQuality] = "Measured")
		formatString: "$"#,0
		displayFolder: Attribution Quality
		lineageTag: b0c31113-3278-4cdd-8cda-b310636e5ec3

	measure 'Estimated Spend' = CALCULATE([Total  Spend.], DimAttributionQuality[AttributionQuality] = "Estimated")
		formatString: "$"#,0
		displayFolder: Attribution Quality
		lineageTag: 50e7aa13-2421-4abf-87d0-62e7b3b660bb

	measure 'Modeled Spend' = CALCULATE([Total  Spend.], DimAttributionQuality[AttributionQuality] = "Modeled")
		formatString: "$"#,0
		displayFolder: Attribution Quality
		lineageTag: 7fe0833e-316f-4558-bf41-ccf64f9fea8a

	measure 'Unknown-Quality Spend' = CALCULATE([Total  Spend.], DimAttributionQuality[AttributionQuality] = "Unknown")
		formatString: "$"#,0
		displayFolder: Attribution Quality
		lineageTag: e0fd96c5-5768-4d9e-b626-7eba9712c983

	measure 'Measured % of Spend' = DIVIDE([Measured Spend], [Total  Spend.])
		formatString: 0.0%
		displayFolder: Attribution Quality
		lineageTag: 1394486e-dc6f-4c40-88b0-907d1859df50

	measure 'Estimated % of Spend' = DIVIDE([Estimated Spend], [Total  Spend.])
		formatString: 0.0%
		displayFolder: Attribution Quality
		lineageTag: e38a53f9-e4e9-419c-be8a-0bbe71ef934a

	measure 'Modeled % of Spend' = DIVIDE([Modeled Spend], [Total  Spend.])
		formatString: 0.0%
		displayFolder: Attribution Quality
		lineageTag: db33f1e5-eacb-49ab-a07c-2642c02d3066

	measure 'Unknown % of Spend' = DIVIDE([Unknown-Quality Spend], [Total  Spend.])
		formatString: 0.0%
		displayFolder: Attribution Quality
		lineageTag: b082ac71-90c4-4ffd-ba1d-ccdbbe563694

	measure 'Data As Of' = FORMAT(MAX(DimDate[Date]), "MMM d, yyyy")
		displayFolder: Info
		lineageTag: ffacf354-5e19-4dd7-b8b8-073f65b2d4bf

	measure 'Row Count' = COUNTROWS(FactTokenSpend)
		formatString: #,0
		displayFolder: Info
		lineageTag: 1b6dc240-6dd6-46b5-9336-79637fb7ba9e

	measure 'Spend WoW % Display' = VAR v = [Spend WoW %] RETURN IF(v >= 0, "↑ " & FORMAT(v, "0.0%") & " vs LW", "↓ " & FORMAT(ABS(v), "0.0%") & " vs LW")
		displayFolder: Spend
		lineageTag: c65b6d93-5e27-4593-9899-b6f3f66639d9

	measure 'Cost per 1K Tokens - Prior Week' = CALCULATE([Cost per 1K Tokens], FILTER(ALL(DimDate), DimDate[WeekIndex] = MAX(DimDate[WeekIndex]) - 1))
		formatString: "$"0.00
		displayFolder: Spend
		lineageTag: 5e7fd953-5298-46df-9e26-080e8e9403ee

	measure 'Cost per 1K Tokens WoW %' = DIVIDE([Cost per 1K Tokens] - [Cost per 1K Tokens - Prior Week], [Cost per 1K Tokens - Prior Week])
		formatString: "↑ "0.0%;"↓ "0.0%
		displayFolder: Spend
		lineageTag: 13ec9b18-ab48-469c-b85a-c5cd7d8c5b33

	measure 'Cost per 1K Tokens WoW % Display' = VAR v = [Cost per 1K Tokens WoW %] RETURN IF(v >= 0, "↑ " & FORMAT(v, "0.0%") & " vs LW", "↓ " & FORMAT(ABS(v), "0.0%") & " vs LW")
		displayFolder: Spend
		lineageTag: e60783ce-b419-410b-af7f-af8467b678de

	measure 'Application Coverage % - Prior Week' = CALCULATE([Application Coverage %], FILTER(ALL(DimDate), DimDate[WeekIndex] = MAX(DimDate[WeekIndex]) - 1))
		formatString: 0.0%
		displayFolder: Coverage
		lineageTag: 5d0a4849-5b1e-4653-839b-a5e13c492928

	measure 'Application Coverage % WoW (pts)' = ([Application Coverage %] - [Application Coverage % - Prior Week]) * 100
		formatString: "↑ "0.0;"↓ "0.0
		displayFolder: Coverage
		lineageTag: 4d24e359-8c6c-4833-bd34-1c5e4d5cec22

	measure 'Application Coverage % WoW Display' = VAR v = [Application Coverage % WoW (pts)] RETURN IF(v >= 0, "↑ " & FORMAT(v, "0.0") & " pts vs LW", "↓ " & FORMAT(ABS(v), "0.0") & " pts vs LW")
		displayFolder: Coverage
		lineageTag: 2373daac-b780-47ae-b685-b1a0960a5d6c

	measure 'Ambiguous Cost - Prior Week' = CALCULATE([Ambiguous Cost], FILTER(ALL(DimDate), DimDate[WeekIndex] = MAX(DimDate[WeekIndex]) - 1))
		formatString: "$"#,0
		displayFolder: Coverage
		lineageTag: ccbf2e73-6d9c-4dae-bcdf-e01aa74705da

	measure 'Ambiguous Cost WoW %' = DIVIDE([Ambiguous Cost] - [Ambiguous Cost - Prior Week], [Ambiguous Cost - Prior Week])
		formatString: "↑ "0.0%;"↓ "0.0%
		displayFolder: Coverage
		lineageTag: 3715218b-63c2-4218-af11-6dc2349c5d19

	measure 'Ambiguous Cost WoW % Display' = VAR v = [Ambiguous Cost WoW %] RETURN IF(v >= 0, "↑ " & FORMAT(v, "0.0%") & " vs LW", "↓ " & FORMAT(ABS(v), "0.0%") & " vs LW")
		displayFolder: Coverage
		lineageTag: f254007f-7d72-4deb-872f-7c4025c4afbc

